# Copy this file to .env and fill in your values. Never commit .env.

# ---------------- Local Android emulator (npm run test:local) ----------------
# Path to the .apk to install on the emulator
ANDROID_APP_PATH=apps/WikipediaSample.apk
# Name shown in Android Studio > Device Manager. Optional: lets Appium start the emulator.
ANDROID_AVD=
ANDROID_DEVICE_NAME=Android Emulator

# ---------------- Perfecto cloud devices (npm run test:perfecto) ----------------
# Your cloud name: the "demo" in https://demo.perfectomobile.com
PERFECTO_CLOUD_NAME=
# Perfecto UI > profile menu (top right) > My Profile > Security Token
PERFECTO_SECURITY_TOKEN=
# Repository key of the uploaded app. `npm run upload` prints it, e.g. PRIVATE:WikipediaSample.apk
PERFECTO_ANDROID_APP=PRIVATE:WikipediaSample.apk
# Device selection is a case-sensitive regular expression. ".*" means any available Android device.
# Examples: ".*Galaxy.*"   "Pixel.*"   "Galaxy S2.*|Pixel.*"
PERFECTO_DEVICE_NAME=.*
# Optional OS version, e.g. 14, or "latest"
PERFECTO_PLATFORM_VERSION=
# Connection settings. Change only if your cloud requires different values.
PERFECTO_PROTOCOL=https
PERFECTO_PORT=443
